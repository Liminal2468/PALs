#!/usr/bin/env bash
set -Eeuo pipefail

mentos_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$mentos_root"

perm_targets=()
for executable_path in "$mentos_root/node_modules/.bin"/* "$mentos_root/api/.venv/bin/api" "$mentos_root/api/.venv/bin/python"; do
  if [[ -e "$executable_path" || -L "$executable_path" ]]; then
    perm_targets+=("$executable_path")
  fi
done
if ((${#perm_targets[@]} > 0)); then
  bash "$mentos_root/bin/permchk" "${perm_targets[@]}"
fi

vite_args=(-- --host 127.0.0.1 --port 5000)
if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet cloudflared.service; then
  printf 'cloudflared.service is active; serving Vite for the tunnel on port 5000.\n'
  vite_args=(-- --host 0.0.0.0 --port 5000)
else
  printf 'cloudflared.service is not active; serving Vite locally on port 5000.\n'
fi

for command_name in npm uv; do
  if ! command -v "$command_name" >/dev/null 2>&1; then
    printf 'Required command not found: %s\n' "$command_name" >&2
    exit 127
  fi
done

if [[ ! -x "$mentos_root/node_modules/.bin/vite" ]]; then
  printf 'Vite is not installed. Run `npm install` in mentos/ first.\n' >&2
  exit 1
fi

npm run dev "${vite_args[@]}" &
vite_pid=$!

uv run --project api api &
api_pid=$!

cleanup() {
  trap - INT TERM EXIT
  kill "$vite_pid" "$api_pid" 2>/dev/null || true
  wait "$vite_pid" 2>/dev/null || true
  wait "$api_pid" 2>/dev/null || true
}

handle_signal() {
  cleanup
  exit 130
}

trap cleanup EXIT
trap handle_signal INT TERM

printf 'Started Mentos Vite and HOST API. Press Ctrl-C to stop both.\n'

if wait -n -p exited_pid "$vite_pid" "$api_pid"; then
  exit_status=0
else
  exit_status=$?
fi

if [[ "$exited_pid" == "$vite_pid" ]]; then
  printf 'Mentos Vite server exited (status %s); stopping HOST API.\n' "$exit_status" >&2
else
  printf 'Mentos HOST API exited (status %s); stopping Vite server.\n' "$exit_status" >&2
fi

exit "$exit_status"
