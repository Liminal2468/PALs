{
  "name": "mentos-api-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "shared",
    "database",
    "accounts",
    "scheduler",
    "feedback",
    "analyst",
    "connect",
    "authentication",
    "chat"
  ],
  "scripts": {
    "start": "node src/server.js",
    "dev": "vite --configLoader runner --config vite.config.js",
    "dev:api": "node --watch src/server.js",
    "dev:ui": "vite --configLoader runner --config vite.config.js",
    "build:ui": "vite build --config vite.config.js",
    "preview:ui": "vite preview --config vite.config.js --host 127.0.0.1 --port 5060 --strictPort",
    "start:web": "npm run build:ui && npm run preview:ui",
    "keygen": "npm run keygen --workspace @mentos/database-api",
    "test": "node --test database/test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "8.7.2",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "vite": "^8.3.8"
  }
}
