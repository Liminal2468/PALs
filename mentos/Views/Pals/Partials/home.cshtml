<div class="topbar">
    <div>
        <div class="topbar-title">Welcome back, <span data-profile-name>Loading profile...</span></div>
        <div class="topbar-sub">Your learning activity and next steps</div>
    </div>
    <div class="topbar-actions">
        <button class="btn-primary" type="button" data-navigate="tutors">Find a tutor</button>
    </div>
</div>

<div class="sub-content">
    <section class="stats-row" aria-label="Your learning activity">
        <article class="stat">
            <div class="stat-label">Sessions this month</div>
            <div class="stat-val" data-home-stat="sessions">—</div>
            <div class="stat-delta">Confirmed or completed this month</div>
        </article>
        <article class="stat">
            <div class="stat-label">Hours logged</div>
            <div class="stat-val" data-home-stat="hours">—</div>
            <div class="stat-delta">From completed sessions</div>
        </article>
        <article class="stat">
            <div class="stat-label">Peer connections</div>
            <div class="stat-val" data-home-stat="tutors">—</div>
            <div class="stat-delta">Peers from confirmed sessions</div>
        </article>
        <article class="stat">
            <div class="stat-label">Open learning requests</div>
            <div class="stat-val" data-home-stat="requests">—</div>
            <div class="stat-delta">Available for peer matching</div>
        </article>
    </section>

    <section class="home-section" aria-labelledby="matchesTitle">
        <div class="section-header">
            <div>
                <h2 class="section-title" id="matchesTitle">Recommended peer tutors</h2>
                <p class="topbar-sub">Ranked using your open learning requests.</p>
            </div>
            <button class="btn-ghost" type="button" data-navigate="tutors">Browse tutors</button>
        </div>
        <div class="home-filters" role="group" aria-label="Filter tutor matches by subject">
            <button class="chip active" type="button" data-home-filter="all" aria-pressed="true">All subjects</button>
            <button class="chip" type="button" data-home-filter="programming" aria-pressed="false">Programming</button>
            <button class="chip" type="button" data-home-filter="math" aria-pressed="false">Math</button>
            <button class="chip" type="button" data-home-filter="science" aria-pressed="false">Science</button>
            <button class="chip" type="button" data-home-filter="research" aria-pressed="false">Research</button>
        </div>
        <div class="tutor-grid home-tutor-grid">
            <p class="empty-state" data-home-empty>Loading recommendations…</p>
        </div>
    </section>

    <section class="home-section upcoming" aria-labelledby="upcomingTitle">
        <div class="section-header">
            <div>
                <h2 class="section-title" id="upcomingTitle">Upcoming sessions</h2>
                <p class="topbar-sub">Requests and sessions involving your account.</p>
            </div>
            <button class="btn-ghost" type="button" data-navigate="sessions">View schedule</button>
        </div>
        <p class="empty-state">Loading your sessions…</p>
    </section>
</div>

<dialog class="app-dialog" data-request-dialog aria-labelledby="requestDialogTitle">
    <form class="app-form" data-request-form>
        <div class="dialog-heading">
            <div><h2 id="requestDialogTitle">Request a tutoring session</h2><p data-request-tutor-label></p></div>
            <button class="icon-button" type="button" data-close-dialog aria-label="Close">&times;</button>
        </div>
        <input type="hidden" name="requestId" data-request-id>
        <input type="hidden" name="candidateUserId" data-candidate-user-id>
        <label>Subject<input name="subject" data-request-subject readonly></label>
        <label>Session starts<input name="scheduledStart" type="datetime-local" step="900" required></label>
        <label>Session ends<input name="scheduledEnd" type="datetime-local" step="900" required></label>
        <p class="form-status" data-request-status role="status" aria-live="polite"></p>
        <div class="form-actions"><button class="btn-ghost" type="button" data-close-dialog>Cancel</button><button class="btn-primary" type="submit">Send session request</button></div>
    </form>
</dialog>
