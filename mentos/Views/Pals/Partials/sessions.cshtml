<div class="topbar">
    <div>
        <div class="topbar-title">My learning sessions</div>
        <div class="topbar-sub">Keep track of session requests and your study schedule</div>
    </div>
    <div class="topbar-actions"><button class="btn-primary" type="button" data-navigate="tutors">Find a tutor</button></div>
</div>

<div class="sub-content">
    <section class="session-intro panel">
        <div>
            <p class="page-eyebrow">Plan your learning</p>
            <h1>Sessions and requests</h1>
            <p class="page-description">Review scheduled requests, confirm sessions sent to you, and keep track of completed sessions.</p>
        </div>
        <div class="session-demo-label"><span class="avail-dot"></span>Account schedule</div>
    </section>

    <section class="stats-row session-stats" aria-label="Session summary">
        <article class="stat"><div class="stat-label">Pending requests</div><div class="stat-val" data-session-stat="requested">0</div><div class="stat-delta">Waiting for a response</div></article>
        <article class="stat"><div class="stat-label">Upcoming sessions</div><div class="stat-val" data-session-stat="upcoming">0</div><div class="stat-delta">Confirmed study plans</div></article>
        <article class="stat"><div class="stat-label">Completed</div><div class="stat-val" data-session-stat="completed">0</div><div class="stat-delta">Completed sessions</div></article>
        <article class="stat"><div class="stat-label">Cancelled</div><div class="stat-val" data-session-stat="cancelled">0</div><div class="stat-delta">Cancelled or declined</div></article>
    </section>

    <section class="sessions-panel panel" aria-labelledby="sessionsListTitle">
        <div class="section-header sessions-heading">
            <div><h2 class="section-title" id="sessionsListTitle">Your schedule</h2><p class="topbar-sub">Pending requests and confirmed sessions involving your account.</p></div>
            <label class="session-filter-label">Show
                <select data-session-filter aria-label="Filter sessions">
                    <option value="all">All sessions</option>
                    <option value="requested">Pending requests</option>
                    <option value="upcoming">Upcoming</option>
                    <option value="completed">Completed</option>
                    <option value="cancelled">Cancelled</option>
                </select>
            </label>
        </div>
        <p class="form-status form-status-error" data-session-status-message role="alert" hidden></p>
        <div class="session-list" data-session-list aria-live="polite">
            <p class="empty-state" data-session-empty>Loading your sessions…</p>
        </div>
    </section>
</div>
