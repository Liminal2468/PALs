<div class="topbar">
    <div>
        <div class="topbar-title">Find a tutee</div>
        <div class="topbar-sub">Explore learning requests matched to your tutor profile</div>
    </div>
    <div class="topbar-actions"><button class="btn-ghost" type="button" data-navigate="tutors">Find a tutor</button><button class="btn-primary" type="button" data-navigate="sessions">My sessions</button></div>
</div>

<div class="sub-content">
    <section class="tutor-intro panel">
        <div>
            <p class="page-eyebrow">Share what you know</p>
            <h1>Find a student to support</h1>
            <p class="page-description">Review current open requests that match your verified tutor subjects. Select a learner and propose a session time for them to confirm.</p>
        </div>
        <div class="tutor-intro-stat"><strong data-tutee-count>—</strong><span>matched requests</span></div>
    </section>

    <section class="tutor-search-panel panel" aria-label="Find students seeking help">
        <div class="tutor-search-grid">
            <label class="tutor-search-field">Search students or topics
                <input type="search" data-tutee-search placeholder="Try a name, subject, or learning goal" autocomplete="off">
            </label>
            <label class="tutor-search-field">Subject
                <select data-tutee-subject>
                    <option value="all">All subjects</option>
                    <option value="programming">Programming</option>
                    <option value="math">Mathematics</option>
                    <option value="science">Science</option>
                    <option value="research">Research</option>
                </select>
            </label>
            <label class="tutor-search-field">Sort by
                <select data-tutee-sort>
                    <option value="match">Best match</option>
                    <option value="name">Name A–Z</option>
                </select>
            </label>
        </div>
        <div class="tutor-result-line"><span data-tutee-results role="status" aria-live="polite">Loading matched requests…</span><button class="text-button" type="button" data-tutee-reset>Clear filters</button></div>
    </section>

    <section class="tutor-results" aria-label="Students seeking peer support">
        <div class="tutor-grid tutor-directory" data-tutee-list></div>
        <p class="empty-state" data-tutee-empty>Loading matched requests…</p>
    </section>
</div>

<dialog class="app-dialog" data-request-dialog data-request-role="tutee" aria-labelledby="requestDialogTitle">
    <form class="app-form" data-request-form data-request-role="tutee">
        <div class="dialog-heading">
            <div><h2 id="requestDialogTitle">Offer peer support</h2><p data-request-tutor-label></p></div>
            <button class="icon-button" type="button" data-close-dialog aria-label="Close">&times;</button>
        </div>
        <input type="hidden" name="requestId" data-request-id>
        <input type="hidden" name="candidateUserId" data-candidate-user-id>
        <label>Subject<input name="subject" data-request-subject readonly></label>
        <label>Session starts<input name="scheduledStart" type="datetime-local" step="900" required></label>
        <label>Session ends<input name="scheduledEnd" type="datetime-local" step="900" required></label>
        <p class="form-status" data-request-status role="status" aria-live="polite"></p>
        <div class="form-actions"><button class="btn-ghost" type="button" data-close-dialog>Cancel</button><button class="btn-primary" type="submit">Send session request</button></div>
    </form>
</dialog>
