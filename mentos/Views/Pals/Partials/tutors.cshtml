<div class="topbar">
    <div>
        <div class="topbar-title">Find a peer tutor</div>
        <div class="topbar-sub">Explore tutors matched to your open learning requests</div>
    </div>
    <div class="topbar-actions">
        <button class="btn-ghost" type="button" data-navigate="sessions">My sessions</button>
    </div>
</div>

<div class="sub-content">
    <section class="tutor-intro panel">
        <div>
            <p class="page-eyebrow">Learn together</p>
            <h1>Find the right study partner</h1>
            <p class="page-description">Recommendations are ranked from active tutor profiles and your learning requests. Choose a match, then propose a session time for the other student to confirm.</p>
        </div>
        <div class="tutor-intro-actions">
            <div class="tutor-intro-stat"><strong data-tutor-count>—</strong><span>matched tutors</span></div>
            <button class="btn-primary" type="button" data-open-learning-request>Post a learning request</button>
        </div>
    </section>

    <section class="tutor-search-panel panel" aria-label="Find tutors">
        <div class="tutor-search-grid">
            <label class="tutor-search-field">Search tutors or subjects
                <input type="search" data-tutor-search placeholder="Try a name, subject, or strand" autocomplete="off">
            </label>
            <label class="tutor-search-field">Subject
                <select data-tutor-subject>
                    <option value="all">All subjects</option>
                    <option value="programming">Programming</option>
                    <option value="math">Mathematics</option>
                    <option value="science">Science</option>
                    <option value="research">Research</option>
                </select>
            </label>
            <label class="tutor-search-field">Sort by
                <select data-tutor-sort>
                    <option value="match">Best match</option>
                    <option value="name">Name A–Z</option>
                </select>
            </label>
        </div>
        <div class="tutor-result-line"><span data-tutor-results role="status" aria-live="polite">Loading recommendations…</span><button class="text-button" type="button" data-tutor-reset>Clear filters</button></div>
        <p class="form-status form-status-error" data-tutor-status role="alert" hidden></p>
    </section>

    <section class="tutor-results" aria-label="Peer tutor results">
        <div class="tutor-grid tutor-directory" data-tutor-list></div>
        <p class="empty-state" data-tutor-empty>Loading recommendations…</p>
    </section>
</div>

<dialog class="app-dialog" data-request-dialog aria-labelledby="requestDialogTitle">
    <form class="app-form" data-request-form>
        <div class="dialog-heading">
            <div><h2 id="requestDialogTitle">Request a tutoring session</h2><p data-request-tutor-label></p></div>
            <button class="icon-button" type="button" data-close-dialog aria-label="Close">&times;</button>
        </div>
        <input type="hidden" name="requestId" data-request-id>
        <input type="hidden" name="candidateUserId" data-candidate-user-id>
        <label>Subject<input name="subject" data-request-subject readonly></label>
        <label>Session starts<input name="scheduledStart" type="datetime-local" step="900" required></label>
        <label>Session ends<input name="scheduledEnd" type="datetime-local" step="900" required></label>
        <p class="form-status" data-request-status role="status" aria-live="polite"></p>
        <div class="form-actions"><button class="btn-ghost" type="button" data-close-dialog>Cancel</button><button class="btn-primary" type="submit">Send session request</button></div>
    </form>
</dialog>

<dialog class="app-dialog" data-learning-request-dialog aria-labelledby="learningRequestTitle">
    <form class="app-form" data-learning-request-form>
        <div class="dialog-heading">
            <div><h2 id="learningRequestTitle">Post a learning request</h2><p>Describe what you want to learn so PALs can find suitable tutors.</p></div>
            <button class="icon-button" type="button" data-close-dialog aria-label="Close">&times;</button>
        </div>
        <label>Subject<select name="subject" required>
            <option value="">Choose a subject</option>
            <option>Computer/Web Programming 4</option><option>Mobile App Programming 2</option>
            <option>General Mathematics</option><option>Statistics and Probability</option>
            <option>Calculus</option><option>Physics</option><option>Chemistry</option>
            <option>Practical Research 1</option><option>Oral Communication</option>
            <option>Understanding Culture, Society, and Politics</option><option>Self Improvement</option>
        </select></label>
        <label>What would you like help with?<textarea name="requestedHelp" rows="4" maxlength="4000" required></textarea></label>
        <label>Current proficiency<select name="currentProficiency"><option value="">Not sure yet</option><option value="1">1 — New to this</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5 — Confident</option></select></label>
        <p class="form-status" data-learning-request-status role="status" aria-live="polite"></p>
        <div class="form-actions"><button class="btn-ghost" type="button" data-close-dialog>Cancel</button><button class="btn-primary" type="submit">Post request</button></div>
    </form>
</dialog>
