{
  "name": "mentos-api-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "shared",
    "database",
    "accounts",
    "scheduler",
    "feedback",
    "analyst",
    "connect",
    "authentication",
    "chat"
  ],
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "keygen": "npm run keygen --workspace @mentos/database-api",
    "test": "node --test database/test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "8.7.2",
    "helmet": "^8.1.0"
  }
}
