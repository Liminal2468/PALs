[Unit]
Description=PALs DBSERV ASP.NET Core API
Wants=network-online.target mariadb.service
After=network-online.target mariadb.service

[Service]
Type=simple
User=palsys
Group=palsys
WorkingDirectory=/var/lib/palsys
Environment=DOTNET_ENVIRONMENT=Production
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=BIND_ADDRESS=127.0.0.1
Environment=PORT=8432
Environment=DATA_PROTECTION_KEY_PATH=/var/lib/palsys/dataprotection
Environment=PATH=/usr/local/libexec:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/env palsys-server
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/palsys
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
