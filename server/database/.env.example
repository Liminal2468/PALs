PORT=8100
# Bind DBSERV to loopback by default; change only for a deliberate direct-network deployment.
BIND_ADDRESS=127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_ALLOWED_TABLES=roles,users,user_roles,student_profiles,subjects,topics,tutor_subjects,learning_requests,availability_slots,match_recommendations,study_sessions,session_participants,session_match_recommendations,session_feedback,research_consents,research_participants,analytics_events,conversations,conversation_members,messages,web_sessions,schedule_events,auth_identities,admin_credentials,auth_attempts,identity_users,identity_roles,identity_user_claims,identity_role_claims,identity_user_roles,identity_user_logins,identity_user_tokens,resources,resource_audits,feedback_posts,feedback_votes,support_tickets
HOST_SHARED_KEY=replace-with-a-private-host-to-dbserv-key
JWT_ISSUER=mentos-host
JWT_AUDIENCE=mentos-db
JWT_TRUSTED_KEYS_DIR=./keys/trusted
# Add these resources to DB_ALLOWED_TABLES after applying schema_v3_auth.sql:
# auth_identities,admin_credentials,auth_attempts

# Developer/admin accounts are seeded through ASP.NET Identity:
# dotnet run --project server/Palsys.Server.csproj -- --seed-developer EMAIL ROLE
# Passwords must be entered interactively and must not be stored here.
